# Cloud Backup Linux - configuração de exemplo
# Copie para /etc/cloud-backup/backup.env e ajuste os valores do seu ambiente.
# NUNCA publique o arquivo real de configuração.

# Servidor remoto
CLOUD_HOST="backup.example.com"
CLOUD_PORT="22"
CLOUD_USER="backup"
CLOUD_BASE_DIR="/srv/backups"
CLOUD_CLIENT_DIR="environment-example"
CLOUD_TRANSFER_METHOD="rsync" # rsync ou scp

# Usuário local responsável pelo envio
BACKUP_USER="backup"
BACKUP_GROUP="backup"
BACKUP_HOME="/home/backup"
SSH_KEY_FILE="/home/backup/.ssh/id_ed25519"
SSH_CONNECT_TIMEOUT="20"
SSH_STRICT_HOST_KEY_CHECKING="yes"
SSH_KNOWN_HOSTS_FILE="/home/backup/.ssh/known_hosts"

# Diretórios locais
BACKUP_ROOT="/opt/backup"
TMP_ROOT="/opt/tmp"
LOG_ROOT="/var/log/cloud-backup"
LOCK_ROOT="/var/lock/cloud-backup"

# Retenção local em dias. Use 0 para não excluir automaticamente.
LOCAL_RETENTION_DAYS="7"

# Informix
INFORMIX_ENABLED="yes"
INFORMIX_USER="informix"
INFORMIX_SERVER="ol_example"
INFORMIX_DIR="/opt/IBM/informix"
INFORMIX_ONCONFIG="onconfig.ol_example"
INFORMIX_SQLHOSTS="/opt/IBM/informix/etc/sqlhosts"
INFORMIX_BACKUP_DIR="/opt/backup/informix"
INFORMIX_BACKUP_PREFIX="informix_backup"
INFORMIX_BACKUP_GLOB="*_0_L0*"
INFORMIX_LEVEL="0"

# PostgreSQL
POSTGRES_ENABLED="yes"
POSTGRES_USER="postgres"
POSTGRES_DB="example_database"
POSTGRES_BACKUP_DIR="/opt/backup/postgres"
POSTGRES_BACKUP_PREFIX="postgres_backup"
POSTGRES_FORMAT="custom" # custom ou plain

# Comportamento
VERIFY_REMOTE_AFTER_UPLOAD="yes"
VERIFY_REMOTE_CHECKSUM="yes"
DELETE_LOCAL_AFTER_UPLOAD="no"
