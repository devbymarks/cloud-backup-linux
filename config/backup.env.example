# /etc/cloud-backup/backup.env
# Configuração por cliente/servidor.

CLOUD_HOST="backup.example.com"
CLOUD_PORT="22"
CLOUD_USER="backup"
CLOUD_BASE_DIR="/backup/clientes"
CLOUD_CLIENT_DIR="cliente_exemplo"

BACKUP_ROOT="/opt/backup"

BACKUP_USER="backup"
BACKUP_GROUP="backup"
SSH_CONNECT_TIMEOUT="20"
SSH_STRICT_HOST_KEY_CHECKING="yes"
SSH_KNOWN_HOSTS_FILE="/home/backup/.ssh/known_hosts"

# Validação obrigatória após o envio.
VERIFY_REMOTE_CHECKSUM="yes"

# Padrões dos arquivos gerados pelo ambiente.
INFORMIX_BACKUP_PATTERN="server-bd_0_L0*"
POSTGRES_BACKUP_PATTERN="bkp_logus*"
